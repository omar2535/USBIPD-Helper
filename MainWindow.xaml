<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="USBIPD_Helper.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:USBIPD_Helper"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="USBIPD-Helper">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid RowDefinitions="Auto,*">
        <InfoBar x:Name="AdminWarning"
             IsOpen="False"
             Severity="Error"
             Title="Administrator privileges required"
             Message="Restart USBIPD-Helper as Administrator to bind, attach, or detach devices." />

        <ListView x:Name="DevicesListView"
              Grid.Row="1"
              SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="local:UsbDeviceInfo">
                    <CheckBox IsChecked="{x:Bind IsChecked, Mode=TwoWay}"
                          Content="{x:Bind Description}"
                          ToolTipService.ToolTip="{x:Bind ToolTipText}"
                          Padding="4"/>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Window>
