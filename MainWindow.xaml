<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="USBIPD_Helper.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:USBIPD_Helper"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="USBIPD-Helper">

    <Window.SystemBackdrop>
        <MicaBackdrop/>
    </Window.SystemBackdrop>

    <Grid RowDefinitions="Auto,Auto,Auto,*" Padding="4">

        <!-- ROW 0 – Admin banner -->
        <InfoBar x:Name="AdminWarning"
                 IsOpen="False"
                 Severity="Error"
                 Title="Administrator privileges required"
                 Message="Restart USBIPD-Helper as Administrator to bind, attach, or detach devices."/>

        <!-- ROW 1 – Title + refresh -->
        <Grid Grid.Row="1" HorizontalAlignment="Left">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="8">
                <TextBlock Text="USBIPD-Helper"
                           FontSize="50"
                           FontWeight="SemiBold"/>
                <Button Width="40"
                        ToolTipService.ToolTip="Refresh devices"
                        Click="RefreshButton_Click">
                    <SymbolIcon Symbol="Refresh"/>
                </Button>
            </StackPanel>
        </Grid>

        <!-- ROW 2 – Table header -->
        <Grid Grid.Row="2" ColumnDefinitions="80,70,70,*,120,90,90" Padding="0,4,0,8">
            <TextBlock Text="Bus ID"  FontWeight="Bold"/>
            <TextBlock Text="VID"     Grid.Column="1" FontWeight="Bold"/>
            <TextBlock Text="PID"     Grid.Column="2" FontWeight="Bold"/>
            <TextBlock Text="Device"  Grid.Column="3" FontWeight="Bold"/>
            <TextBlock Text="State"   Grid.Column="4" FontWeight="Bold"/>
            <TextBlock Text="Bind"    Grid.Column="5" FontWeight="Bold" HorizontalAlignment="Center"/>
            <TextBlock Text="Attach"  Grid.Column="6" FontWeight="Bold" HorizontalAlignment="Center"/>
        </Grid>

        <!-- ROW 3 – Data rows -->
        <ListView x:Name="DevicesListView"
                  Grid.Row="3"
                  SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="local:UsbDeviceInfo">
                    <Grid ColumnDefinitions="80,70,70,*,120,90,90" Padding="2">

                        <TextBlock Text="{x:Bind BusId}"/>
                        <TextBlock Grid.Column="1" Text="{x:Bind Vid}"/>
                        <TextBlock Grid.Column="2" Text="{x:Bind Pid}"/>

                        <!-- Device name + info icon -->
                        <StackPanel Grid.Column="3"
                                    Orientation="Horizontal"
                                    Spacing="4">
                            <TextBlock Text="{x:Bind Description}"/>
                            <TextBlock Text="i"
                                       FontStyle="Italic"
                                       Foreground="Gray"
                                       Visibility="{x:Bind InfoVisibility}"
                                       ToolTipService.ToolTip="{x:Bind Detail}"/>
                        </StackPanel>

                        <TextBlock Grid.Column="4" Text="{x:Bind State}"/>

                        <!-- Bind / Unbind -->
                        <Button Grid.Column="5"
                                Content="{x:Bind BindActionText}"
                                IsEnabled="{x:Bind BindEnabled}"
                                Click="BindButton_Click"
                                Tag="{x:Bind}"/>

                        <!-- Attach / Detach -->
                        <Button Grid.Column="6"
                                Content="{x:Bind AttachActionText}"
                                IsEnabled="{x:Bind AttachEnabled}"
                                Click="AttachButton_Click"
                                Tag="{x:Bind}"/>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Window>
